# Единственное место, где задаются версии. Отсюда их читают и build.sh,
# и docker compose.

# --- базовый образ ---------------------------------------------------------
# Пин по дайджесту, а не только по тегу: теги на Docker Hub мутабельны,
# обновление nginx внутри может приехать перезаливкой того же тега.
# Актуальный дайджест: ./build.sh --check
NGINX_UI_IMAGE=uozi/nginx-ui
NGINX_UI_TAG=latest
NGINX_UI_DIGEST=sha256:7453ecde10267db2b03c24cdc2bbef386212c118046298278ae21d017942a514

# Должен совпадать с релизом Debian в базовом образе (сейчас trixie).
# Сборка сама проверит и упадёт при расхождении.
BUILDER_BASE=debian:trixie-slim

# --- компоненты WAF --------------------------------------------------------
MODSEC_VERSION=v3.0.17
MODSEC_NGINX_VERSION=v1.0.4
CRS_VERSION=4.30.0

# --- локальный образ -------------------------------------------------------
IMAGE_NAME=nginx-ui-modsec
# Проставляется автоматически при успешной сборке. Откат = вернуть сюда
# предыдущее значение и `docker compose up -d`.
IMAGE_TAG=

# Пусто = собирать под архитектуру этой машины. Заполнять только если
# образ собирается под другую платформу (напр. linux/amd64 на Apple Silicon).
PLATFORM=linux/amd64

TZ=Europe/Moscow
